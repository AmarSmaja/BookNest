<%- include("../partials/layout-top") %>

<div class="auth-wrap">
  <div class="auth-card" style="max-width: 860px;">
    <div class="auth-card-header">
      <h1>Registracija</h1>
      <p>Kreiraj račun i izaberi interese (žanrovi i jezici) za preporuke.</p>
    </div>

    <div class="auth-card-body">
      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/auth/register">
        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 12px 16px;">
          <div class="form-row">
            <label>Ime</label>
            <input name="ime" required />
          </div>

          <div class="form-row">
            <label>Prezime</label>
            <input name="prezime" required />
          </div>

          <div class="form-row" style="grid-column: 1 / span 2;">
            <label>Email</label>
            <input type="email" name="email" required />
          </div>

          <div class="form-row" style="grid-column: 1 / span 2;">
            <label>Lozinka</label>
            <input type="password" name="password" required />
          </div>

          <div class="form-row">
            <label>Žanrovi (interesi)</label>

            <% if (genres && genres.length > 0) { %>
              <div class="check-grid">
                <% for (var i = 0; i < genres.length; i++) { %>
                  <label class="check-item">
                    <input type="checkbox" name="zanrovi" value="<%= genres[i].id %>" />
                    <span><%= genres[i].naziv %></span>
                  </label>
                <% } %>
              </div>
            <% } else { %>
              <div class="form-hint">Nema žanrova.</div>
            <% } %>
          </div>

          <div class="form-row">
            <label>Jezici (interesi)</label>

            <% if (languages && languages.length > 0) { %>
              <div class="check-grid">
                <% for (var j = 0; j < languages.length; j++) { %>
                  <label class="check-item">
                    <input type="checkbox" name="jezici" value="<%= languages[j].id %>" />
                    <span><%= languages[j].naziv %></span>
                  </label>
                <% } %>
              </div>
            <% } else { %>
              <div class="form-hint">Nema jezika.</div>
            <% } %>
          </div>
        </div>

        <div class="form-actions" style="margin-top: 14px;">
          <button class="btn btn-primary" type="submit">Registruj se</button>
          <div class="form-hint">
            Već imaš račun?
            <a href="/auth/login">Login</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/layout-bottom") %>