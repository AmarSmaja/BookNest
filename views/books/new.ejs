<h1><%= title %></h1>

<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<form method="post" action="/seller/books">
  <div>
    <label>Naziv</label><br />
    <input name="naziv" value="<%= values.naziv || '' %>" required />
  </div>

  <div>
    <label>Autor</label><br />
    <input name="autor" value="<%= values.autor || '' %>" required />
  </div>

  <div>
    <label>Izdavač</label><br />
    <input name="izdavac" value="<%= values.izdavac || '' %>" />
  </div>

  <div>
    <label>Godina izdavanja</label><br />
    <input name="godinaIzdavanja" type="number" value="<%= values.godinaIzdavanja || '' %>" />
  </div>

  <div>
    <label>Opis</label><br />
    <textarea name="opis" rows="4"><%= values.opis || '' %></textarea>
  </div>

  <div>
    <label>Žanr</label><br />
    <select name="zanrId" required>
      <option value="">-- odaberi --</option>
      <% genres.forEach(g => { %>
        <option value="<%= g.id %>" <%= String(values.zanrId) === String(g.id) ? 'selected' : '' %>><%= g.naziv %></option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>Jezik</label><br />
    <select name="jezikId" required>
      <option value="">-- odaberi --</option>
      <% languages.forEach(l => { %>
        <option value="<%= l.id %>" <%= String(values.jezikId) === String(l.id) ? 'selected' : '' %>><%= l.naziv %></option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>Stanje</label><br />
    <select name="stanjeId" required>
      <option value="">odaberi</option>
      <% conditions.forEach(c => { %>
        <option value="<%= c.id %>" <%= String(values.stanjeId) === String(c.id) ? 'selected' : '' %>><%= c.naziv %></option>
      <% }) %>
    </select>
  </div>

  <div>
    <label>Cijena</label><br />
    <input name="cijena" type="number" step="0.01" value="<%= values.cijena || '0' %>" required />
  </div>

  <div>
    <label>Glavna slika URL</label><br />
    <input name="glavnaSlikaUrl" value="<%= values.glavnaSlikaUrl || '' %>" placeholder="https://..." />
  </div>

  <div>
    <label>
      <input type="checkbox" name="spremnaZaRazmjenu" <%= (values.spremnaZaRazmjenu === 'on' || values.spremnaZaRazmjenu === true) ? 'checked' : '' %> />
      Spremna za razmjenu
    </label>
  </div>

  <div style="margin-top:12px;">
    <button type="submit">Sačuvaj</button>
    <a href="/seller/books">Otkaži</a>
  </div>
</form>
