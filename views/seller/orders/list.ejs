<h1><%= title %></h1>

<% if (!narudzbe || narudzbe.length === 0) { %>
  <p>Nema narudžbi.</p>
<% } else { %>
  <table border="1" cellpadding="6">
    <thead>
      <tr>
        <th>ID</th>
        <th>Tip</th>
        <th>Status</th>
        <th>Ukupno</th>
        <th>Akcija</th>
      </tr>
    </thead>
    <tbody>
      <% narudzbe.forEach(o => { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.tip %></td>
          <td><%= o.status %></td>
          <td><%= o.ukupnaCijena %></td>
          <td><a href="/seller/orders/<%= o.id %>">Detalji</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
