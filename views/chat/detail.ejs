<%- include("../partials/layout-top") %>

<%
  var otherName = "Razgovor";
  if (otherUser) {
    var ime = "";
    if (otherUser.ime !== undefined && otherUser.ime !== null) ime = String(otherUser.ime);

    var prezime = "";
    if (otherUser.prezime !== undefined && otherUser.prezime !== null) prezime = String(otherUser.prezime);

    var full = (ime + " " + prezime).trim();
    if (full.length > 0) otherName = full;
    else if (otherUser.email) otherName = String(otherUser.email);
  }

  var convId = null;
  if (conversation && conversation.id !== undefined && conversation.id !== null) convId = Number(conversation.id);

  var myId = null;
  if (currentUser && currentUser.id !== undefined && currentUser.id !== null) myId = Number(currentUser.id);

  var msgArr = [];
  if (messages && messages.length) msgArr = messages;
%>

<div class="chat-detail-head">
  <div>
    <h1>Chat</h1>
    <div class="muted"><%= otherName %></div>
  </div>
  <div>
    <a class="btn btn-ghost" href="/chat">Nazad</a>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<div class="panel chat-messages" id="chatMessages">
  <% if (!msgArr || msgArr.length === 0) { %>
    <div class="empty-state">Nema poruka. Pošalji prvu poruku.</div>
  <% } else { %>
    <% for (var i = 0; i < msgArr.length; i++) { %>
      <% var m = msgArr[i]; %>

      <%
        var senderId = null;
        if (m.posiljalacId !== undefined && m.posiljalacId !== null) senderId = Number(m.posiljalacId);

        var isMe = false;
        if (myId !== null && senderId !== null && Number.isFinite(myId) && Number.isFinite(senderId)) {
          if (myId === senderId) isMe = true;
        }

        var text = "";
        if (m.sadrzaj !== undefined && m.sadrzaj !== null) text = String(m.sadrzaj);

        var vrijeme = "";
        if (m.createdAt) {
          try { vrijeme = new Date(m.createdAt).toLocaleString(); } catch (e) { vrijeme = ""; }
        }

        var rowCls = "msg-row";
        if (isMe) rowCls = "msg-row me";
      %>

      <div class="<%= rowCls %>">
        <div class="msg-bubble">
          <div class="msg-text"><%= text %></div>
          <div class="msg-meta muted">
            <% if (isMe) { %>Ti<% } else { %><%= otherName %><% } %>
            <% if (vrijeme) { %> • <%= vrijeme %><% } %>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<div class="panel chat-send">
  <form method="post" action="/chat/<%= convId %>/send">
    <textarea name="body" placeholder="Napiši poruku..." required></textarea>
    <div class="chat-send-actions">
      <button class="btn btn-primary" type="submit">Pošalji</button>
    </div>
  </form>
</div>

<script>
  (function () {
    var el = document.getElementById("chatMessages");
    if (el) {
      el.scrollTop = el.scrollHeight;
    }
  })();
</script>

<%- include("../partials/layout-bottom") %>