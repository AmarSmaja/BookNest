<h1><%= title %></h1>

<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>

<div style="display:flex; flex-wrap:wrap; gap:20px;">
  <div style="width:420px; border:1px solid #ddd; padding:10px;">
    <h3>Knjige po statusu</h3>
    <canvas id="booksStatusChart" width="400" height="300"></canvas>
  </div>

  <div style="width:520px; border:1px solid #ddd; padding:10px;">
    <h3>Narudžbe po statusu</h3>
    <canvas id="ordersStatusChart" width="500" height="300"></canvas>
  </div>

  <div style="width:720px; border:1px solid #ddd; padding:10px;">
    <h3>Top žanrovi (aktivne knjige na stanju)</h3>
    <canvas id="topGenresChart" width="700" height="320"></canvas>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  var booksByStatus = <%- JSON.stringify(stats.booksByStatus) %>;
  var ordersByStatus = <%- JSON.stringify(stats.ordersByStatus) %>;
  var topGenres = <%- JSON.stringify(stats.topGenres) %>;

  function toLabels(rows) {
    var labels = [];
    for (var i = 0; i < rows.length; i++) {
      labels.push(rows[i].status || rows[i].label);
    }
    return labels;
  }

  function toCounts(rows) {
    var counts = [];
    for (var i = 0; i < rows.length; i++) {
      counts.push(Number(rows[i].count));
    }
    return counts;
  }

  var ctx1 = document.getElementById("booksStatusChart");
  new Chart(ctx1, {
    type: "pie",
    data: { labels: toLabels(booksByStatus), datasets: [{ data: toCounts(booksByStatus) }] }
  });

  var ctx2 = document.getElementById("ordersStatusChart");
  new Chart(ctx2, {
    type: "bar",
    data: { labels: toLabels(ordersByStatus), datasets: [{ label: "Broj narudžbi", data: toCounts(ordersByStatus) }] },
    options: { scales: { y: { beginAtZero: true } } }
  });

  var ctx3 = document.getElementById("topGenresChart");
  new Chart(ctx3, {
    type: "bar",
    data: { labels: toLabels(topGenres), datasets: [{ label: "Aktivne knjige", data: toCounts(topGenres) }] },
    options: { scales: { y: { beginAtZero: true } } }
  });
</script>