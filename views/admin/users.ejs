<h1>Admin - Users</h1>
<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<table border="1" cellpadding="6">
  <tr>
    <th>ID</th><th>Email</th><th>Ime</th><th>Role</th><th>Status</th><th>Blokiran do</th><th>Akcije</th>
  </tr>
  <% users.forEach(user => { %>
    <tr>
      <td><%= user.id %></td>
      <td><%= user.email %></td>
      <td><%= user.ime %> <%= user.prezime %></td>
      <td><%= user.role %></td>
      <td><%= user.status %></td>
      <td><%= user.blokiran_do ? new Date(user.blokiran_do).toLocaleString() : "" %></td>
      <td>
        <form style="display:inline" method="post" action="/admin/users/<%= user.id %>/role">
          <select name="role">
            <option>Admin</option>
            <option>Prodavac</option>
            <option>Kupac</option>
          </select>
          <button>Postavi Role</button>
        </form>

        <form style="display:inline" method="post" action="/admin/users/<%= user.id %>/status">
          <select name="status">
            <option>Aktivan</option>
            <option>Deaktiviran</option>
            <option>Arhiviran</option>
            <option>Blokiran</option>
          </select>
          <button>Postavi Status</button>
        </form>

        <form style="display:inline" method="post" action="/admin/users/<%= user.id %>/block">
          <select name="mode">
            <option value="15">15 dana</option>
            <option value="permanent">Zauvijek</option>
          </select>
          <button>Blokiraj</button>
        </form>

        <form style="display:inline" method="post" action="/admin/users/<%= user.id %>/unblock">
          <button>Odblokiraj</button>
        </form>

        <form method="post" action="/auth/logout">
          <button type="submit">Logout</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>