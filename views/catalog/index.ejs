<h1><%= title %></h1>

<form method="get" action="/catalog" style="margin: 12px 0; padding: 10px; border:1px solid #ddd;">
  <div>
    <label>Pretraga:</label>
    <input name="q" value="<%= filters.q %>" placeholder="Naziv / Autor / Izdavač" />
  </div>

  <div style="margin-top:8px;">
    <label>Žanr:</label>
    <select name="genreId">
      <% var selG0 = ""; if (!filters.genreId || filters.genreId === "" || filters.genreId === "0") selG0 = "selected"; %>
      <option value="0" <%= selG0 %>>Svi</option>
      <% for (var i = 0; i < genres.length; i++) { %>
        <% var selG = ""; if (String(genres[i].id) === String(filters.genreId)) selG = "selected"; %>
        <option value="<%= genres[i].id %>" <%= selG %>><%= genres[i].naziv %></option>
      <% } %>
    </select>

    <label>Jezik:</label>
    <select name="languageId">
      <% var selL0 = ""; if (!filters.languageId || filters.languageId === "" || filters.languageId === "0") selL0 = "selected"; %>
      <option value="0" <%= selL0 %>>Svi</option>
      <% for (var j = 0; j < languages.length; j++) { %>
        <% var selL = ""; if (String(languages[j].id) === String(filters.languageId)) selL = "selected"; %>
        <option value="<%= languages[j].id %>" <%= selL %>><%= languages[j].naziv %></option>
      <% } %>
    </select>

    <label>Stanje:</label>
    <select name="conditionId">
      <% var selC0 = ""; if (!filters.conditionId || filters.conditionId === "" || filters.conditionId === "0") selC0 = "selected"; %>
      <option value="0" <%= selC0 %>>Sva</option>
      <% for (var k = 0; k < conditions.length; k++) { %>
        <% var selC = ""; if (String(conditions[k].id) === String(filters.conditionId)) selC = "selected"; %>
        <option value="<%= conditions[k].id %>" <%= selC %>><%= conditions[k].naziv %></option>
      <% } %>
    </select>
  </div>

  <div style="margin-top:8px;">
    <label>Razmjena:</label>
    <select name="exchangeable">
      <% var exAll = ""; if (!filters.exchangeable || filters.exchangeable === "") exAll = "selected"; %>
      <% var exYes = ""; if (filters.exchangeable === "1") exYes = "selected"; %>
      <% var exNo = ""; if (filters.exchangeable === "0") exNo = "selected"; %>
      <option value="" <%= exAll %>>Sve</option>
      <option value="1" <%= exYes %>>Samo razmjena</option>
      <option value="0" <%= exNo %>>Bez razmjene</option>
    </select>

    <label>Min cijena:</label>
    <input name="minPrice" value="<%= filters.minPrice %>" style="width:90px;" />

    <label>Max cijena:</label>
    <input name="maxPrice" value="<%= filters.maxPrice %>" style="width:90px;" />

    <label>Sort:</label>
    <select name="sort">
      <% var s1 = ""; if (!filters.sort || filters.sort === "newest") s1 = "selected"; %>
      <% var s2 = ""; if (filters.sort === "price_asc") s2 = "selected"; %>
      <% var s3 = ""; if (filters.sort === "price_desc") s3 = "selected"; %>
      <% var s4 = ""; if (filters.sort === "name_asc") s4 = "selected"; %>
      <% var s5 = ""; if (filters.sort === "popular") s5 = "selected"; %>
      <option value="newest" <%= s1 %>>Najnovije</option>
      <option value="price_asc" <%= s2 %>>Cijena ↑</option>
      <option value="price_desc" <%= s3 %>>Cijena ↓</option>
      <option value="name_asc" <%= s4 %>>Naziv A-Z</option>
      <option value="popular" <%= s5 %>>Popularno</option>
    </select>

    <button type="submit">Traži</button>
  </div>

  <% if (filters.page && Number(filters.page) > 1) { %>
    <input type="hidden" name="page" value="<%= filters.page %>" />
  <% } %>
</form>

<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<% if (!knjige || knjige.length === 0) { %>
  <p>Nema knjiga za prikaz.</p>
<% } else { %>
  <ul style="list-style:none; padding:0;">
    <% for (var x = 0; x < knjige.length; x++) { %>
      <li style="margin: 12px 0; padding: 12px; border: 1px solid #444;">
        <div style="display:flex; gap:12px;">
          <div style="width:120px;">
            <% if (knjige[x].glavnaSlikaUrl) { %>
              <img src="<%= knjige[x].glavnaSlikaUrl %>" alt="cover" style="width:120px; height:auto;" />
            <% } %>
          </div>

          <div>
            <h3 style="margin:0;">
              <a href="/books/<%= knjige[x].id %>"><%= knjige[x].naziv %></a>
            </h3>

            <div><strong>Autor:</strong> <%= knjige[x].autor %></div>
            <div><strong>Žanr:</strong> <%= knjige[x].zanrNaziv %> | <strong>Jezik:</strong> <%= knjige[x].jezikNaziv %> | <strong>Stanje:</strong> <%= knjige[x].stanjeNaziv %></div>
            <div><strong>Cijena:</strong> <%= knjige[x].cijena %></div>
            <div><strong>Na stanju:</strong> <%= knjige[x].kolicinaDostupno %></div>
            <div><strong>Prodavač:</strong> <%= knjige[x].prodavacIme %> <%= knjige[x].prodavacPrezime %></div>

            <% if (knjige[x].spremnaZaRazmjenu) { %>
              <div>Spremna za razmjenu</div>
            <% } %>
          </div>
        </div>
      </li>
    <% } %>
  </ul>

  <div style="margin-top:16px;">
    <% var prevPage = Number(filters.page) - 1; %>
    <% var nextPage = Number(filters.page) + 1; %>

    <% if (Number(filters.page) > 1) { %>
      <a href="/catalog?<%= "q=" + encodeURIComponent(filters.q || "") %>&genreId=<%= filters.genreId || 0 %>&languageId=<%= filters.languageId || 0 %>&conditionId=<%= filters.conditionId || 0 %>&exchangeable=<%= filters.exchangeable || "" %>&minPrice=<%= filters.minPrice || "" %>&maxPrice=<%= filters.maxPrice || "" %>&sort=<%= filters.sort || "newest" %>&page=<%= prevPage %>">Prev</a>
    <% } %>

    <span style="margin:0 12px;">Stranica: <%= filters.page %></span>

    <% if (knjige && knjige.length === 24) { %>
      <a href="/catalog?<%= "q=" + encodeURIComponent(filters.q || "") %>&genreId=<%= filters.genreId || 0 %>&languageId=<%= filters.languageId || 0 %>&conditionId=<%= filters.conditionId || 0 %>&exchangeable=<%= filters.exchangeable || "" %>&minPrice=<%= filters.minPrice || "" %>&maxPrice=<%= filters.maxPrice || "" %>&sort=<%= filters.sort || "newest" %>&page=<%= nextPage %>">Next</a>
    <% } %>
  </div>
<% } %>