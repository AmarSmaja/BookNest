<%- include("../partials/layout-top") %>

<%
  var qVal = "";
  var genreVal = "";
  var languageVal = "";
  var conditionVal = "";
  var exchangeVal = "";
  var minVal = "";
  var maxVal = "";
  var sortVal = "newest";

  if (filters) {
    if (filters.q !== undefined && filters.q !== null) qVal = String(filters.q);
    if (filters.genreId !== undefined && filters.genreId !== null) genreVal = String(filters.genreId);
    if (filters.languageId !== undefined && filters.languageId !== null) languageVal = String(filters.languageId);
    if (filters.conditionId !== undefined && filters.conditionId !== null) conditionVal = String(filters.conditionId);
    if (filters.exchangeable !== undefined && filters.exchangeable !== null) exchangeVal = String(filters.exchangeable);
    if (filters.minPrice !== undefined && filters.minPrice !== null) minVal = String(filters.minPrice);
    if (filters.maxPrice !== undefined && filters.maxPrice !== null) maxVal = String(filters.maxPrice);
    if (filters.sort !== undefined && filters.sort !== null) sortVal = String(filters.sort);
  }
%>

<h1 style="margin-top:10px;"><%= title %></h1>

<div class="filters-card">
  <div class="filters-head">
    <h2>Pretraga i filteri</h2>
    <div class="results-count">
      <% var cnt = 0; %>
      <% if (knjige && knjige.length) cnt = knjige.length; %>
      Prikaz: <%= cnt %>
    </div>
  </div>

  <div class="filters-body">
    <form method="get" action="/catalog">
      <div class="filters-grid">
        <div class="filters-row" style="grid-column: 1 / span 1;">
          <label>Pretraga</label>
          <input name="q" placeholder="Naziv / Autor / Izdavač" value="<%= qVal %>" />
        </div>

        <div class="filters-row">
          <label>Žanr</label>
          <select name="genreId">
            <option value="0" <% if (!genreVal || genreVal === "0") { %>selected<% } %>>Svi</option>
            <% if (genres && genres.length > 0) { %>
              <% for (var i = 0; i < genres.length; i++) { %>
                <% var g = genres[i]; %>
                <option value="<%= g.id %>" <% if (genreVal === String(g.id)) { %>selected<% } %>><%= g.naziv %></option>
              <% } %>
            <% } %>
          </select>
        </div>

        <div class="filters-row">
          <label>Jezik</label>
          <select name="languageId">
            <option value="0" <% if (!languageVal || languageVal === "0") { %>selected<% } %>>Svi</option>
            <% if (languages && languages.length > 0) { %>
              <% for (var j = 0; j < languages.length; j++) { %>
                <% var l = languages[j]; %>
                <option value="<%= l.id %>" <% if (languageVal === String(l.id)) { %>selected<% } %>><%= l.naziv %></option>
              <% } %>
            <% } %>
          </select>
        </div>

        <div class="filters-row">
          <label>Stanje</label>
          <select name="conditionId">
            <option value="0" <% if (!conditionVal || conditionVal === "0") { %>selected<% } %>>Sva</option>
            <% if (conditions && conditions.length > 0) { %>
              <% for (var k = 0; k < conditions.length; k++) { %>
                <% var c = conditions[k]; %>
                <option value="<%= c.id %>" <% if (conditionVal === String(c.id)) { %>selected<% } %>><%= c.naziv %></option>
              <% } %>
            <% } %>
          </select>
        </div>

        <div class="filters-row">
          <label>Razmjena</label>
          <select name="exchangeable">
            <option value="" <% if (!exchangeVal) { %>selected<% } %>>Sve</option>
            <option value="1" <% if (exchangeVal === "1") { %>selected<% } %>>Da</option>
            <option value="0" <% if (exchangeVal === "0") { %>selected<% } %>>Ne</option>
          </select>
        </div>

        <div class="filters-row">
          <label>Min cijena</label>
          <input name="minPrice" value="<%= minVal %>" />
        </div>

        <div class="filters-row">
          <label>Max cijena</label>
          <input name="maxPrice" value="<%= maxVal %>" />
        </div>

        <div class="filters-row">
          <label>Sort</label>
          <select name="sort">
            <option value="newest" <% if (sortVal === "newest") { %>selected<% } %>>Najnovije</option>
            <option value="price_asc" <% if (sortVal === "price_asc") { %>selected<% } %>>Cijena ↑</option>
            <option value="price_desc" <% if (sortVal === "price_desc") { %>selected<% } %>>Cijena ↓</option>
            <option value="name_asc" <% if (sortVal === "name_asc") { %>selected<% } %>>Naziv A–Z</option>
            <option value="popular" <% if (sortVal === "popular") { %>selected<% } %>>Popularno</option>
          </select>
        </div>
      </div>

      <div class="filters-actions">
        <button class="btn btn-primary" type="submit">Traži</button>
        <a class="btn btn-ghost" href="/catalog">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="results-bar">
  <div class="results-count">
    <% var cnt2 = 0; %>
    <% if (knjige && knjige.length) cnt2 = knjige.length; %>
    Pronađeno: <%= cnt2 %>
  </div>
</div>

<% if (!knjige || knjige.length === 0) { %>
  <div class="empty-state">Nema knjiga za prikaz.</div>
<% } else { %>
  <div class="books-grid">
    <% for (var i2 = 0; i2 < knjige.length; i2++) { %>
      <% var b = knjige[i2]; %>

      <% var cijenaTekst = ""; %>
      <% if (b.cijena !== undefined && b.cijena !== null) { %>
        <% cijenaTekst = String(b.cijena); %>
      <% } %>

      <div class="book-card">
        <a class="book-link" href="/books/<%= b.id %>">
          <div class="book-cover">
            <% if (b.glavnaSlikaUrl) { %>
              <img src="<%= b.glavnaSlikaUrl %>" alt="cover" />
            <% } else { %>
              <div class="book-cover-empty">Nema slike</div>
            <% } %>
          </div>

          <div class="book-meta">
            <div class="book-title"><%= b.naziv %></div>
            <div class="book-author"><%= b.autor %></div>

            <div class="book-footer">
              <span class="link-like">Detalji</span>
              <% if (cijenaTekst) { %>
                <span class="book-price"><%= cijenaTekst %> KM</span>
              <% } %>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<%- include("../partials/layout-bottom") %>