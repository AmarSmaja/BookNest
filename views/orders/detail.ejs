<h1><%= title %></h1>

<% if (error) { %><p style="color:red"><%= error %></p><% } %>

<p><strong>Status:</strong> <%= narudzba.status %></p>
<p><strong>Tip:</strong> <%= narudzba.tip %></p>
<p><strong>Ukupno:</strong> <%= narudzba.ukupnaCijena %></p>

<h3>Stavke</h3>
<% if (!items || items.length === 0) { %>
  <p>Nema stavki.</p>
<% } else { %>
  <table border="1" cellpadding="6">
    <thead>
      <tr>
        <th>Knjiga</th>
        <th>Cijena u trenutku</th>
        <th>Ocijeni</th>
      </tr>
    </thead>
    <tbody>
      <% for (let idx = 0; idx < items.length; idx++) { %>
        <% const i = items[idx]; %>

        <% let cijena = i.cijenaUTrenutku; %>
        <% if (cijena == null) { cijena = i.cijenaUtrenutku; } %>

        <tr>
          <td>
            <% if (i.knjiga) { %>
              <a href="/books/<%= i.knjiga.id %>">
                <%= i.knjiga.naziv %> — <%= i.knjiga.autor %>
              </a>
            <% } else { %>
              Book ID: <%= i.bookId %>
            <% } %>
          </td>
          <td><%= cijena %></td>
          <td>
  <% if (narudzba.status === "Zavrsena" && i.knjiga) { %>
    <a href="/ratings/new?orderId=<%= narudzba.id %>&bookId=<%= i.knjiga.id %>">Ocijeni</a>
  <% } else { %>
    -
  <% } %>
</td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<% if (narudzba.status === "Na_cekanju") { %>
  <h3>Otkazivanje</h3>
  <form method="post" action="/orders/<%= narudzba.id %>/cancel" onsubmit="return confirm('Otkazati narudžbu?');">
    <button type="submit">Otkaži narudžbu</button>
  </form>
<% } %>

<p><a href="/orders">Nazad</a></p>
