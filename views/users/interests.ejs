<%- include("../partials/layout-top") %>

<h1>Moji interesi</h1>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<% if (success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<div class="panel">
  <form method="post" action="/users/interests">
    <h2 style="margin-top:0;">Žanrovi</h2>

    <% if (!genres || genres.length === 0) { %>
      <div class="empty-state">Nema žanrova.</div>
    <% } else { %>
      <div class="check-grid">
        <% for (var i = 0; i < genres.length; i++) { %>
          <% var g = genres[i]; %>

          <%
            var checked = false;
            if (selectedGenreIds && selectedGenreIds.length) {
              for (var x = 0; x < selectedGenreIds.length; x++) {
                if (Number(selectedGenreIds[x]) === Number(g.id)) checked = true;
              }
            }
          %>

          <label class="check-item">
            <input type="checkbox" name="zanrovi" value="<%= g.id %>" <% if (checked) { %>checked<% } %> />
            <span><%= g.naziv %></span>
          </label>
        <% } %>
      </div>
    <% } %>

    <hr style="margin:18px 0;" />

    <h2>Jezici</h2>

    <% if (!languages || languages.length === 0) { %>
      <div class="empty-state">Nema jezika.</div>
    <% } else { %>
      <div class="check-grid">
        <% for (var j = 0; j < languages.length; j++) { %>
          <% var l = languages[j]; %>

          <%
            var checked2 = false;
            if (selectedLanguageIds && selectedLanguageIds.length) {
              for (var y = 0; y < selectedLanguageIds.length; y++) {
                if (Number(selectedLanguageIds[y]) === Number(l.id)) checked2 = true;
              }
            }
          %>

          <label class="check-item">
            <input type="checkbox" name="jezici" value="<%= l.id %>" <% if (checked2) { %>checked<% } %> />
            <span><%= l.naziv %></span>
          </label>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:16px; display:flex; gap:10px; justify-content:flex-end;">
      <button class="btn btn-primary" type="submit">Sačuvaj</button>
    </div>
  </form>
</div>

<%- include("../partials/layout-bottom") %>