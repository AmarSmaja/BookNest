<%- include("partials/layout-top") %>

<h1><%= title %></h1>

<hr />
<h2>Najpopularnije knjige</h2>

<% if (!popular || popular.length === 0) { %>
  <p>Nema popularnih knjiga.</p>
<% } else { %>
  <div class="books-row">
    <% for (var i = 0; i < popular.length; i++) { %>
      <% var b = popular[i]; %>

      <% var prosjekTekst = "-"; %>
      <% if (b.prosjekOcjena !== undefined && b.prosjekOcjena !== null) { %>
        <% prosjekTekst = Number(b.prosjekOcjena).toFixed(1); %>
      <% } %>

      <% var brojOcjenaTekst = 0; %>
      <% if (b.brojOcjena !== undefined && b.brojOcjena !== null) { %>
        <% brojOcjenaTekst = Number(b.brojOcjena); %>
        <% if (!Number.isFinite(brojOcjenaTekst)) brojOcjenaTekst = 0; %>
      <% } %>

      <% var zavrseneTekst = 0; %>
      <% if (b.brojZavrsenihNarudzbi !== undefined && b.brojZavrsenihNarudzbi !== null) { %>
        <% zavrseneTekst = Number(b.brojZavrsenihNarudzbi); %>
        <% if (!Number.isFinite(zavrseneTekst)) zavrseneTekst = 0; %>
      <% } %>

      <div class="book-card">
        <a class="book-link" href="/books/<%= b.id %>">
          <div class="book-cover">
            <% if (b.glavnaSlikaUrl) { %>
              <img src="<%= b.glavnaSlikaUrl %>" alt="cover" />
            <% } else { %>
              <div class="book-cover-empty">Nema slike</div>
            <% } %>
          </div>

          <div class="book-meta">
          <div class="book-title"><%= b.naziv %></div>
          <div class="book-author"><%= b.autor %></div>

          <% var cijenaTekst = ""; %>
          <% if (b.cijena !== undefined && b.cijena !== null) { %>
            <% cijenaTekst = String(b.cijena); %>
          <% } %>

          <div class="book-footer">
            <span class="link-like">Detalji</span>
            <% if (cijenaTekst) { %>
              <span class="book-price"><%= cijenaTekst %> KM</span>
            <% } %>
          </div>
        </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<h2>Preporučene knjige</h2>

<% if (!recommended || recommended.length === 0) { %>
  <% if (user) { %>
    <p>Nema preporučenih knjiga. Dodaj interese u profilu da dobiješ preporuke.</p>
  <% } else { %>
    <p>Nema preporučenih knjiga.</p>
  <% } %>
<% } else { %>
  <div class="books-row">
    <% for (var i = 0; i < recommended.length; i++) { %>
      <% var b = recommended[i]; %>

      <div class="book-card">
        <a class="book-link" href="/books/<%= b.id %>">
          <div class="book-cover">
            <% if (b.glavnaSlikaUrl) { %>
              <img src="<%= b.glavnaSlikaUrl %>" alt="cover" />
            <% } else { %>
              <div class="book-cover-empty">Nema slike</div>
            <% } %>
          </div>

          <div class="book-meta">
          <div class="book-title"><%= b.naziv %></div>
          <div class="book-author"><%= b.autor %></div>

          <% var cijenaTekst = ""; %>
          <% if (b.cijena !== undefined && b.cijena !== null) { %>
            <% cijenaTekst = String(b.cijena); %>
          <% } %>

          <div class="book-footer">
            <span class="link-like">Detalji</span>
            <% if (cijenaTekst) { %>
              <span class="book-price"><%= cijenaTekst %> KM</span>
            <% } %>
          </div>
        </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<hr />
<h2>Random</h2>

<% if (!knjige || knjige.length === 0) { %>
  <p>Nema aktivnih knjiga.</p>
<% } else { %>
  <div class="books-grid">
    <% for (var i = 0; i < knjige.length; i++) { %>
      <% var b = knjige[i]; %>

      <div class="book-card">
        <a class="book-link" href="/books/<%= b.id %>">
          <div class="book-cover">
            <% if (b.glavnaSlikaUrl) { %>
              <img src="<%= b.glavnaSlikaUrl %>" alt="cover" />
            <% } else { %>
              <div class="book-cover-empty">Nema slike</div>
            <% } %>
          </div>

          <div class="book-meta">
          <div class="book-title"><%= b.naziv %></div>
          <div class="book-author"><%= b.autor %></div>

          <% var cijenaTekst = ""; %>
          <% if (b.cijena !== undefined && b.cijena !== null) { %>
            <% cijenaTekst = String(b.cijena); %>
          <% } %>

          <div class="book-footer">
            <span class="link-like">Detalji</span>
            <% if (cijenaTekst) { %>
              <span class="book-price"><%= cijenaTekst %> KM</span>
            <% } %>
          </div>
        </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<%- include("partials/layout-bottom") %>